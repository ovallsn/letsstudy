rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function accountProfilePath(userId) {
      return /databases/$(database)/documents/users/$(userId)/profile/account;
    }

    function usernameReservationPath(username) {
      return /databases/$(database)/documents/usernameReservations/$(username);
    }

    function leaderboardOwnerPath(entryId) {
      return /databases/$(database)/documents/leaderboardOwners/$(entryId);
    }

    function leaderboardSettingsPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/leaderboard/settings;
    }

    function validUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 20
        && value.matches('^[a-z0-9]+(_[a-z0-9]+)*$')
        && !value.matches('.*(asshole|bastard|bitch|cabron|connard|cunt|fuck|fag|gilipollas|joder|maricon|merde|mierda|motherfucker|nigga|nigger|pendejo|porn|puta|putain|puto|salope|shit|slut|whore).*')
        && !value.matches('^(admin|administrator|help|letsstudy|moderator|official|root|support|system)([0-9_].*)?$');
    }

    function validLeaderboardNickname(value) {
      return validUsername(value);
    }

    function validLeaderboardOwner(entryId, owner) {
      return owner.keys().hasOnly(['ownerUid', 'entryId', 'displayName', 'weekKey'])
        && owner.keys().hasAll(['ownerUid', 'entryId', 'displayName', 'weekKey'])
        && owner.ownerUid is string
        && owner.entryId == entryId
        && validLeaderboardNickname(owner.displayName)
        && owner.weekKey is string
        && owner.weekKey.matches('^[0-9]{4}-W[0-9]{2}$');
    }

    function validLeaderboardSettings(settings) {
      return settings.keys().hasOnly(['enabled', 'entryId', 'displayName', 'updatedAt', 'sharePhoto'])
        && settings.keys().hasAll(['enabled', 'entryId', 'displayName', 'updatedAt'])
        && settings.enabled == true
        && settings.entryId is string
        && settings.entryId.size() >= 20
        && settings.entryId.size() <= 40
        && validLeaderboardNickname(settings.displayName)
        && settings.updatedAt is timestamp
        && (!('sharePhoto' in settings) || settings.sharePhoto is bool);
    }

    function validPublicLeaderboardEntry(entry) {
      return entry.keys().hasOnly(['displayName', 'weeklyPoints', 'weekKey', 'avatarThumb'])
        && entry.keys().hasAll(['displayName', 'weeklyPoints', 'weekKey'])
        && validLeaderboardNickname(entry.displayName)
        && entry.weeklyPoints is int
        && entry.weeklyPoints >= 0
        && entry.weeklyPoints <= 500
        && entry.weekKey is string
        && entry.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && (!('avatarThumb' in entry)
          || (entry.avatarThumb is bytes
            && entry.avatarThumb.size() <= 12288));
    }

    function settingsHaveLinkedOwner(entryId, userId, displayName) {
      let owner = getAfter(leaderboardOwnerPath(entryId)).data;
      return owner.ownerUid == userId
        && owner.entryId == entryId
        && owner.displayName == displayName;
    }

    function settingsAreActiveFor(entryId, userId) {
      let settings = getAfter(leaderboardSettingsPath(userId)).data;
      return settings.enabled == true && settings.entryId == entryId;
    }

    function publicEntryHasActiveOwner(entryId, entry, userId) {
      let owner = getAfter(leaderboardOwnerPath(entryId)).data;
      let settings = getAfter(leaderboardSettingsPath(userId)).data;
      return owner.ownerUid == userId
        && owner.entryId == entryId
        && owner.displayName == entry.displayName
        && owner.weekKey == entry.weekKey
        && settings.enabled == true
        && settings.entryId == entryId
        && settings.displayName == entry.displayName
        && (!('avatarThumb' in entry) || settings.sharePhoto == true);
    }

    function validAccountProfile(profile) {
      return profile.keys().hasOnly(['displayName', 'username', 'updatedAt'])
        && profile.keys().hasAll(['displayName', 'username', 'updatedAt'])
        && profile.displayName is string
        && profile.displayName.size() > 0
        && profile.displayName.size() <= 80
        && profile.username is string
        && validUsername(profile.username)
        && profile.updatedAt is timestamp;
    }

    match /users/{userId}/studyData/{documentId} {
      allow read, write: if signedInAs(userId);
    }

    match /users/{userId}/leaderboard/{settingsId} {
      allow get: if signedInAs(userId) && settingsId == 'settings';
      allow list: if false;
      allow create: if signedInAs(userId)
        && settingsId == 'settings'
        && validLeaderboardSettings(request.resource.data)
        && settingsHaveLinkedOwner(request.resource.data.entryId, userId, request.resource.data.displayName);
      allow update: if signedInAs(userId)
        && settingsId == 'settings'
        && request.resource.data.entryId == resource.data.entryId
        && validLeaderboardSettings(request.resource.data)
        && settingsHaveLinkedOwner(request.resource.data.entryId, userId, request.resource.data.displayName);
      allow delete: if signedInAs(userId) && settingsId == 'settings';
    }

    match /users/{userId}/profile/{profileId} {
      allow get: if signedInAs(userId) && profileId == 'account';
      allow list: if false;
      allow create: if signedInAs(userId)
        && profileId == 'account'
        && validAccountProfile(request.resource.data)
        && !exists(usernameReservationPath(request.resource.data.username))
        && existsAfter(usernameReservationPath(request.resource.data.username))
        && getAfter(usernameReservationPath(request.resource.data.username)).data.username == request.resource.data.username;
      allow update: if signedInAs(userId)
        && profileId == 'account'
        && validAccountProfile(request.resource.data)
        && (request.resource.data.username == resource.data.username
          || !exists(usernameReservationPath(request.resource.data.username)))
        && existsAfter(usernameReservationPath(request.resource.data.username))
        && getAfter(usernameReservationPath(request.resource.data.username)).data.username == request.resource.data.username;
      allow delete: if signedInAs(userId)
        && profileId == 'account'
        && (!('username' in resource.data)
          || !existsAfter(usernameReservationPath(resource.data.username)));
    }

    match /usernameReservations/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['username'])
        && request.resource.data.keys().hasAll(['username'])
        && request.resource.data.username == username
        && existsAfter(accountProfilePath(request.auth.uid))
        && getAfter(accountProfilePath(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.username == username
        && exists(accountProfilePath(request.auth.uid))
        && get(accountProfilePath(request.auth.uid)).data.username == username
        && (!existsAfter(accountProfilePath(request.auth.uid))
          || getAfter(accountProfilePath(request.auth.uid)).data.username != username);
    }

    match /leaderboardOwners/{entryId} {
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow list: if false;
      allow create: if request.auth != null
        && validLeaderboardOwner(entryId, request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && settingsAreActiveFor(entryId, request.auth.uid);
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && validLeaderboardOwner(entryId, request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && settingsAreActiveFor(entryId, request.auth.uid);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /publicLeaderboard/{entryId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 25;
      allow create: if request.auth != null
        && validPublicLeaderboardEntry(request.resource.data)
        && publicEntryHasActiveOwner(entryId, request.resource.data, request.auth.uid);
      allow update: if request.auth != null
        && validPublicLeaderboardEntry(request.resource.data)
        && (request.resource.data.weekKey != resource.data.weekKey
          || request.resource.data.weeklyPoints >= resource.data.weeklyPoints)
        && publicEntryHasActiveOwner(entryId, request.resource.data, request.auth.uid);
      allow delete: if request.auth != null
        && exists(leaderboardOwnerPath(entryId))
        && get(leaderboardOwnerPath(entryId)).data.ownerUid == request.auth.uid;
    }
  }
}
